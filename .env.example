# ---------------------------------------------------------------------------
# Copiá este archivo como `.env.local` y completá los valores.
# `.env.local` está en .gitignore: NUNCA lo commitees.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Creá un proyecto propio en https://supabase.com y pegá acá SUS credenciales.
# Para armar el schema corré, en el SQL Editor de tu proyecto y en este orden:
#   1. db/01_base.sql     (las 6 tablas + RLS + triggers + realtime)
#   2. db/02_pedido.sql   (lo que suma el expediente)
# Ver db/README.md. Los .sql de db/legacy/ están obsoletos: no los corras.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Bypassea RLS: jamás lo expongas al browser ni lo commitees.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Timeout (ms) de los fetch del cliente Supabase. Default: 12000.
# NEXT_PUBLIC_SUPABASE_FETCH_TIMEOUT_MS=12000

# --- OpenRouter (chat IA, /api/chat) --------------------------------------
# Sin esta key el widget de chat responde con error, el resto de la app anda.
OPENROUTER_API_KEY=
# Opcionales (tienen default en el código):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_MAX_RETRIES=2
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_X_TITLE=

# --- Gmail (notificaciones por mail, /api/send-task-notification) ---------
# Requiere 2FA + una "App Password" de 16 caracteres (sin espacios).
# https://myaccount.google.com/apppasswords
# Sin esto, el envío de mails falla; el resto de la app anda.
GMAIL_USER=
GMAIL_APP_PASSWORD=
